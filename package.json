{
  "name": "crm-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start",
    "worker:ai-campaign": "tsx --tsconfig tsconfig.json src/workers/ai-campaign-worker.js",
    "test": "vitest run",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js",
    "db:backfill:campaign-runtime": "node scripts/backfill-campaign-job-runtime.cjs",
    "theme:assets:generate": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-default-theme-pngs.ps1",
    "theme:assets:apply": "node ./scripts/apply-default-theme-assets.cjs",
    "theme:assets:defaults": "npm run theme:assets:generate && npm run theme:assets:apply",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@deepgram/sdk": "^4.11.3",
    "@elevenlabs/elevenlabs-js": "^2.36.0",
    "@google/generative-ai": "^0.24.1",
    "@langchain/langgraph": "^0.2.74",
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/client": "6.16.2",
    "@tanstack/react-table": "^8.21.3",
    "@twilio/voice-sdk": "^2.18.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.58.1",
    "clsx": "^2.1.1",
    "groq-sdk": "^0.3.1",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.13",
    "openai": "^6.22.0",
    "prisma": "6.16.2",
    "razorpay": "^2.9.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "twilio": "^5.12.2",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/react": "19.2.14",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "vitest": "^2.1.8"
  }
}
